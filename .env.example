# ───────────────────────────────────────────────
# CRM 대시보드 환경변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요:
#   cp .env.example .env
# .env 는 .gitignore 로 제외되어 커밋되지 않습니다.
# ───────────────────────────────────────────────

# ── 서버 / 데이터 경로 (Docker Manager 배포용) ──
# 서버 포트. Docker Manager가 주입하면 그 값을 사용, 없으면 3000.
# Dockerfile EXPOSE 3000 / Docker Manager 헬스체크(:3000)와 반드시 일치시킬 것.
PORT=3000
# 런타임 데이터 파일(crm-campaign-data.json 등) 저장 경로.
# Docker 배포 시 볼륨 경로(/app/data)로 설정하면 재배포 후에도 데이터가 유지됨.
DATA_DIR=/app/data

# ── SQL Server (bar_shop1, Azure SQL) 접속정보 ──
DB_SERVER=your-db-host
DB_PORT=1433
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ── 대시보드 로그인 (Basic Auth) ──
CRM_AUTH_USER=barunson
CRM_AUTH_PASS=change-me

# ── Bitly URL 단축 (URL 관리 기능) ──
BITLY_TOKEN=

# ── GA4 Data API (브랜드메시지 성과의 "GA4 자동조회" = UTM 유입 세션) ──
# 숫자 속성 ID (GA4 관리 > 속성 설정). 측정 ID G-xxxxxxx 가 아니다.
# 비워두면 코드 기본값(바른손카드 속성 265717923)을 사용한다.
GA4_PROPERTY_ID=265717923
# 서비스계정 키 JSON 원문(한 줄). Docker 컨테이너에는 키 파일을 넣을 수 없으므로 이 방식을 쓴다.
# 발급: GCP Console > IAM > 서비스 계정 > 키 추가(JSON)
# 그 다음 GA4 관리 > 속성 액세스 관리에서 서비스계정 이메일을 '뷰어'로 추가해야 한다.
GA4_SA_JSON=
# (대안) 키 파일 경로를 쓰는 로컬 실행용
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# ── Claude API ([성과 분석] 탭의 AI 데일리 브리핑에 필요) ──
# 없으면 브리핑 버튼이 "키가 설정되지 않았습니다" 안내만 띄우고, 나머지 기능은 정상 동작합니다.
# 발급: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=
